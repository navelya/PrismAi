# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Pixabay API (for image scraping - Free unlimited searches!)
# Get your free key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your-pixabay-api-key

# App Configuration — subdomain split
# In production: app + marketing on the SAME Vercel project, different hosts.
# Leave the *_URL values pointing at localhost in dev so the split is disabled
# (neutral host). To test the split locally, set MARKETING_URL=http://localhost:3000
# and APP_URL=http://app.localhost:3000 (app.localhost resolves to 127.0.0.1).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
# Auth cookie domain — set ONLY in production to share the session across
# subdomains. Must start with a dot. Leave UNSET locally (browsers reject
# .localhost cookie domains).
# NEXT_PUBLIC_COOKIE_DOMAIN=.prisfol.com

# Replicate AI (for image/video/audio generation)
# Get your token at: https://replicate.com/account/tokens
REPLICATE_API_TOKEN=your-replicate-api-token
# Get your webhook signing secret at: https://replicate.com/webhooks
REPLICATE_WEBHOOK_SIGNING_SECRET=your-replicate-webhook-signing-secret

# Dodo Payments (billing — subscriptions + credit packs)
# Get your API key at: https://dashboard.dodopayments.com/developer/api-keys
DODO_API_KEY=your-dodo-api-key
# Environment: "test_mode" for sandbox, "live_mode" for production
DODO_ENVIRONMENT=test_mode
# Webhook signing secret — run "node scripts/dodo-setup-webhook.js" to create the
# webhook endpoint in Dodo and get this key. Webhook URL: $NEXT_PUBLIC_APP_URL/api/webhooks/dodo
DODO_WEBHOOK_KEY=your-dodo-webhook-key
