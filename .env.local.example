# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Pixabay API (for image scraping - Free unlimited searches!)
# Get your free key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your-pixabay-api-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Replicate AI (for image/video/audio generation)
# Get your token at: https://replicate.com/account/tokens
REPLICATE_API_TOKEN=your-replicate-api-token
# Get your webhook signing secret at: https://replicate.com/webhooks
REPLICATE_WEBHOOK_SIGNING_SECRET=your-replicate-webhook-signing-secret

# Python Backend URL (Hugging Face Spaces in production)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Internal API Key for Python backend authentication
# Set the same value in both the Next.js app and the Python backend
INTERNAL_API_KEY=your-internal-api-key
