{
    "buildCommand": "npm run build",
    "outputDirectory": ".next",
    "framework": "nextjs",
    "regions": [
        "iad1"
    ],
    "crons": [
        {
            "path": "/api/cron/cleanup-sessions",
            "schedule": "0 2 * * *"
        },
        {
            "path": "/api/cron/topup",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/cron/reconcile",
            "schedule": "0 4 * * *"
        }
    ]
}